    "url": "git+https://github.com/devicelab-dev/maestro-runner.git"
  },
  "license": "Apache-2.0",
  "author": "DeviceLab (https://devicelab.dev)",
  "type": "commonjs",
  "main": "lib/resolve.js",
  "bin": {
