# Binaries
# Anchored: the built binary at the repo root. Unanchored, this pattern
# also swallowed npm/maestro-runner/, the published npm package source.
/maestro-runner
maestro-runner-*
*.exe

# Build artifacts
# Anchored for the same reason as the binary above: unanchored, `bin/` also
# hid npm/maestro-runner/bin/, which holds the published CLI shim.
/bin/
dist/
build-release.sh
build-dist.sh
release.sh
install.sh
install-download.sh

# Test coverage & profiling
coverage.out
coverage.html
*.test
*.out
*.prof

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
pkg/cli/reports/
reports/
apks/
CLAUDE.md
.claude/

# Cache (WDA builds, etc.)
cache/

# Generated at build time
THIRD_PARTY_LICENSES

# Local-only files
BUILD_INSTRUCTIONS.md
testdata/
scripts/
docs_local/
research/
examples/

# Internal planning / research files. Kept local to avoid creating
# cross-repo backlinks via GitHub's automatic org/repo#N indexing.
PLAN-*.md
RESEARCH-*.md
DOC-GAPS.md
LANDING-DOC-UPDATES-*.md
SAUCE-LABS-HOOKS.md
ROADMAP.md
SNAPSHOT_MODE_SPEC.md

# npm platform packages are assembled from dist/<version>/ by npm/build-npm.sh.
# Each carries a ~50MB binary plus drivers; they are build output, not source.
npm/platforms/
npm/**/node_modules/
