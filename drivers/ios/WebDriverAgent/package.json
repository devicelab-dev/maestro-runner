{
  "name": "appium-webdriveragent",
  "version": "16.17.5",
  "description": "Package bundling WebDriverAgent",
  "keywords": [
    "Appium",
    "Selenium",
    "WebDriver",
    "WebDriverAgent",
    "iOS"
  ],
  "homepage": "https://github.com/appium/appium-ios/tree/main/packages/webdriveragent",
  "bugs": {
    "url": "https://github.com/appium/appium-ios/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-ios.git",
    "directory": "packages/webdriveragent"
  },
  "files": [
    "lib",
    "build/lib",
    "Scripts/build.sh",
    "Scripts/embed-runner-icon.sh",
    "Scripts/*.mjs",
    "Configurations",
    "PrivateHeaders",
    "WebDriverAgent.xcodeproj",
    "WebDriverAgentLib",
    "WebDriverAgentRunner",
    "WebDriverAgentTests",
    "XCTWebDriverAgentLib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build -- --watch",
    "clean": "npm run build -- --clean",
    "prepare": "npm run build",
    "version": "npm run sync-wda-version",
    "test": "node --enable-source-maps --experimental-test-module-mocks --test --test-timeout=60000 \"./build/test/unit/**/*.spec.js\"",
    "e2e-test": "node --enable-source-maps --test --test-force-exit --test-concurrency=1 --test-timeout=600000 \"./build/test/functional/**/*.spec.js\"",
    "bundle": "npm run bundle:ios && npm run bundle:tv && npm run bundle:watch",
    "bundle:ios": "TARGET=runner SDK=sim node ./Scripts/build-webdriveragent.mjs",
    "bundle:tv": "TARGET=tv_runner SDK=tv_sim node ./Scripts/build-webdriveragent.mjs",
    "bundle:watch": "TARGET=watch_runner SDK=watch_sim node ./Scripts/build-webdriveragent.mjs",
    "fetch-prebuilt-wda": "node ./Scripts/fetch-prebuilt-wda.mjs",
    "sync-wda-version": "node ./Scripts/update-wda-version.mjs --package-version=${npm_package_version} && git add WebDriverAgentLib/Info.plist"
  },
  "dependencies": {
    "@appium/base-driver": "^10.8.0",
    "@appium/strongbox": "^2.0.0",
    "@appium/support": "^7.2.6",
    "asyncbox": "^6.5.0",
    "axios": "^1.18.0",
    "teen_process": "^4.2.0"
  },
  "devDependencies": {
    "@appium/coresim": "^1.14.0",
    "@appium/oxc-config": "^1.1.0",
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.0.0-rc.1",
    "@types/node": "^26.0.0",
    "@types/sinon": "^22.0.0",
    "appium-xcode": "^7.2.4",
    "semver": "^7.3.7",
    "sinon": "^22.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
